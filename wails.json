{
  "$schema": "https://wails.io/schemas/config.v3.json",
  "name": "go-cine-sort",
  "outputfilename": "cine-sort",
  "info": {
    "companyName": "Cine Sort",
    "productName": "Cine Sort",
    "productVersion": "1.0.0",
    "copyright": "Copyright © Cine Sort",
    "comments": "电影整理工作台"
  },
  "bindings": {
    "output": "frontend/bindings"
  },
  "frontend": {
    "dir": "./frontend",
    "install": "pnpm install --frozen-lockfile",
    "build": "pnpm run build",
    "dev": "pnpm run dev",
    "devServerUrl": "http://127.0.0.1:5173"
  }
}
